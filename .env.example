# Copy to .env and fill in values
SECRET_KEY=change-me-to-a-random-string

# Anthropic (meal parsing + coach chat)
ANTHROPIC_API_KEY=sk-ant-...

APP_BASE_URL=https://moron.bigpour.app

# Seed account — created by init_db.py if the users table is empty.
# Change the password after first login; this only sets the initial value.
AUTH_USERNAME=ryan
AUTH_PASSWORD=change-me

# How many days to keep meal photos before cleanup_photos.py deletes them
PHOTO_RETENTION_DAYS=30
